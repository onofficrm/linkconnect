# 직접 URL로 index.html 접근 차단 (page.php 경유·enabled 검사 우회 방지)
# Cafe24: Options / Require(2.4) 미지원 시 디렉터리 전체 500 방지를 위해 2.2 호환만 사용
<IfModule mod_authz_core.c>
    <FilesMatch "\.(html|htm)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(php|phtml|phar|cgi|pl|exe|sh|bat|cmd)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(html|htm)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(php|phtml|phar|cgi|pl|exe|sh|bat|cmd)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
